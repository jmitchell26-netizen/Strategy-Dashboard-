# Copy to .env and fill in. Never commit .env with real keys.

# https://newsapi.org — required for the live feed
VITE_NEWSAPI_KEY=

# --- LLM for company profiles (pick OpenAI OR Ollama) ---
# Optional: force which backend: openai | ollama
# VITE_LLM_PROVIDER=ollama

# https://platform.openai.com — paid API; optional if using Ollama
VITE_OPENAI_API_KEY=

# Ollama (local is free): https://ollama.com — run `ollama serve` and pull a model e.g. `ollama pull llama3.2`
# Local default base URL (omit if 127.0.0.1:11434). For Ollama Cloud, set base URL + API key from your account.
VITE_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional; local Ollama often needs no key. Ollama Cloud may require it.
VITE_OLLAMA_API_KEY=
# Model must exist locally: ollama list
VITE_OLLAMA_MODEL=llama3.2
